# --- База данных (по умолчанию общий SQLite: ../data/trading.db) ---
# DB_URL=sqlite:///D:/projects/alg_trading/data/trading.db
# DB_URL=postgresql+psycopg://postgres:password@localhost:5432/trading

# --- Сеть ---
# Прокси только для Мосбиржи (если VPN не пускает на iss.moex.com), например:
# MARKET_PROXY=socks5h://user:pass@ru-proxy:1080   (для socks: pip install requests[socks])
# MARKET_PROXY=

# --- Стратегия (значения по умолчанию) ---
# HOLD_DAYS=2           # удержание, торговых дней
# EXIT_AT_OPEN=false    # выход по времени по открытию последнего дня (у исполнителя TIME_EXIT=10.02)
# STOP_ATR=1.5          # стоп = вход - 1.5*ATR(14)
# TAKE_ATR=2.0          # тейк = вход + 2.0*ATR(14)
# MAX_SIGNALS=4         # бумаг в день
# MAX_PER_SECTOR=1
# MIN_PROBABILITY=0.55
# MIN_EDGE=0.003        # ожидаемая доходность сделки после издержек
# MIN_TURNOVER=100000000
# BROKER_COMMISSION=0.0005  # ALOR «Первый», на сторону
# EXCHANGE_FEE=0.0001
# SLIPPAGE=0.0003
# REGIME_FILTER=true
# SIGNAL_TIME=6.30      # время МСК (часы.минуты) формирования сигналов

# --- ИИ (AI_Manager) ---
AI_ENABLED=true
AI_URL=http://127.0.0.1:8000
AI_PASSWORD=пароль_из_AI_Manager/.env
AI_MODEL=qwen36-35b-a3b
# AI_MIN_CONFIDENCE=40  # вето ИИ учитывается при уверенности >= 40
# NEWS_RSS=https://www.interfax.ru/rss.asp,https://rssexport.rbc.ru/rbcnews/news/30/full.rss

# --- Telegram (необязательно) ---
# TLG_NOTICE_TOKEN=
# TLG_NOTICE_CHAT_ID=

# --- Реверсивный алгоритм (elements/reverse) ---
# REVERSE_ENABLED=true
# REVERSE_NEWS_MODEL=qwen36-35b-a3b   # оценка новостей и проверка сигналов
# REVERSE_MIND_MODEL=gpt-oss-20b      # ночной разбор опыта, гипотезы, параметры
# REVERSE_REVIEW=true                 # ИИ-вето для сигналов реверсивного
# REVERSE_NEWS_EVERY=1200             # секунд между сборами новостей
# REVERSE_NIGHT=22:30-05:30           # окно ночного разбора
# NEWS_BATCH=30                       # заголовков в одном запросе к модели
# NEWS_FEEDS=https://www.interfax.ru/rss.asp,https://www.finam.ru/analysis/conews/rsspoint/
